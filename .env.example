# ─────────────────────────────────────────────
# Database (required) — pixelim-net uses its OWN database
# ─────────────────────────────────────────────
# The cluster/URI may be shared with the pixelim.co.il project (which uses the
# "test" database). Keep this app's data isolated by naming a DIFFERENT database
# in the path (the "/pixelim_net" segment below). Every collection (leads,
# visitor_events, activity_log, email_sender, email_settings,
# notification_subscribers) is created inside whatever database you name here —
# so a unique name = fully separate data, no code changes needed.
# Do NOT leave the database segment empty and do NOT use "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pixelim_net?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# Admin authentication
# ─────────────────────────────────────────────

# Username for /admin/login (optional — if set, login requires both username AND password)
ADMIN_USERNAME=admin

# Password for /admin/login (required to log in)
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies — use a long random string in production
# e.g. openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-use-a-long-random-string

# Comma-separated Google account emails allowed to log in via Google OAuth
# Leave empty to disable Google login (password login always works)
ADMIN_USERS=you@gmail.com,colleague@gmail.com

# ─────────────────────────────────────────────
# Email notifications for new leads (all optional — configure in Admin → Notifications)
# ─────────────────────────────────────────────

# Option A (recommended): Gmail/Workspace SMTP + App Password.
# Either paste the App Password in Admin → Notifications → SMTP, or set these:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=you@yourdomain.com

# Option B: Google Apps Script Web App webhook (deploy your OWN script/sheet).
# When set, lead emails route through it instead of SMTP/OAuth.
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Make.com — forward every lead to a scenario (optional)
# ─────────────────────────────────────────────
MAKE_WEBHOOK_URL=

# ─────────────────────────────────────────────
# Google OAuth — admin Google login (optional) + legacy Gmail send
# Redirect URIs to register:
#   <site>/api/admin/auth/google/callback   (admin login)
#   <site>/api/email/oauth/callback          (Gmail send connect)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Site config
# ─────────────────────────────────────────────

# Absolute site URL (no trailing slash) — used for OAuth redirects and email CTAs
NEXT_PUBLIC_SITE_URL=https://pixelim.net
